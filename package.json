{
  "name": "@dxlliv/owd-nuxt-theme-win95",
  "version": "4.0.0-alpha.3",
  "description": "Open Web Desktop theme",
  "keywords": [
    "owd-client",
    "owd-themes",
    "owd-modules"
  ],
  "homepage": "https://github.com/dxlliv/owd-nuxt-theme-win95#readme",
  "bugs": {
    "url": "https://github.com/dxlliv/owd-nuxt-theme-win95/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxlliv/owd-nuxt-theme-win95.git"
  },
  "license": "MIT",
  "author": {
    "name": "Diego Villa",
    "url": "https://github.com/dxlliv"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "setup": "pnpm install",
    "prepublishOnly": "node -e 'if (process.env.npm_package_version?.includes(\"verdaccio\") && !process.env.ALLOW_VERDACCIO) { console.error(\"FATAL: Snapshot versions (*-verdaccio.*) cannot be published to public npm!\"); process.exit(1); }'",
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && cd playground && pnpm exec nuxt dev",
    "dev:build": "nuxt build playground",
    "dev:generate": "NUXT_APP_BASE_URL=${NUXT_APP_BASE_URL:-/owd-nuxt-theme-win95/} nuxt generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && cd playground && pnpm exec nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "validate": "desktop validate ."
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "@owdproject/kit-primevue": "^4.0.0-alpha.3",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.6.2",
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/module-fs": "^4.0.0-alpha.3",
    "@owdproject/app-terminal": "^4.0.0-alpha.3",
    "@owdproject/nuxt-persistence-pinia": "^4.0.0-alpha.3",
    "@owdproject/kit-primevue": "^4.0.0-alpha.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "~29.1.1",
    "nuxt": "^4.6.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "tailwindcss": "^3.4.19",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/nuxt": "^4.0.0-alpha.3",
    "@owdproject/kit-primevue": "^4.0.0-alpha.3",
    "@owdproject/kit-tailwind": "^4.0.0-alpha.3",
    "@owdproject/module-fs": "^4.0.0-alpha.3",
    "@owdproject/nuxt-persistence-pinia": "^4.0.0-alpha.3",
    "nuxt": "^4.6.2"
  },
  "peerDependenciesMeta": {
    "@owdproject/module-fs": {
      "optional": true
    },
    "@owdproject/nuxt-persistence-pinia": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
